rules_version = '2';
// GrokGold Firestore rules: the public site can ONLY create waitlist entries.
// Nobody can read, list, update or delete them from the browser.
// Read sign-ups in the Firebase console or with the Admin SDK.
service cloud.firestore {
  match /databases/{database}/documents {
    match /waitlist/{entryId} {
      allow read, update, delete: if false;
      allow create: if
        request.resource.data.keys().hasOnly(['name','email','plan','experience','proxies','message','consent','riskAck','source','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.plan is string && request.resource.data.plan.size() <= 40
        && request.resource.data.experience is string && request.resource.data.experience.size() <= 40
        && request.resource.data.proxies is bool
        && request.resource.data.message is string && request.resource.data.message.size() <= 1000
        && request.resource.data.consent == true
        && request.resource.data.riskAck == true
        && request.resource.data.source is string && request.resource.data.source.size() <= 300
        && request.resource.data.createdAt == request.time;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
